@{
    ViewData["Title"] = "Danh sách sản phẩm";

    var categories = ViewBag.Categories;
    var products = ViewBag.Products;
}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <h4>DANH MỤC</h4>

            <div class="list-group">
                @foreach (var item in categories)
                {
                    <a asp-action="Index"
                       asp-route-categoryId="@item.Id"
                       class="list-group-item list-group-item-action">
                        @item.Name
                    </a>
                }
            </div>
        </div>
        <div class="col-md-9">
            <h3>Danh sách sản phẩm</h3>
            <div class="row">
                @foreach (var item in products)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100"><img src="@item.Image"alt="@item.Name"class="card-img-top"style="height: 200px; object-fit: cover;" />
                            <div class="card-body">
                                <h5>@item.Name</h5>
                                <p>Giá:@item.Price.ToString("N0") đ</p>
                                <p>Giá sale:@item.SalePrice.ToString("N0") đ
                                </p><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success w-100">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
