@model Lgh_Baitaptulam01.Models.LghProduct

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="row">

    <div class="col-md-5">
        <img src="@Model.Image"
             alt="@Model.Name"
             class="img-fluid" />
    </div>

    <div class="col-md-7">

        <h2>@Model.Name</h2>

        <p>
            <strong>Giá gốc:</strong>
            @Model.Price.ToString("N0") đ
        </p>

        <p>
            <strong>Giá sale:</strong>
            @Model.SalePrice.ToString("N0") đ
        </p>

        <p>
            <strong>Mô tả:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Trạng thái:</strong>
            @Model.Status
        </p>

        <a asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>

    </div>

</div>