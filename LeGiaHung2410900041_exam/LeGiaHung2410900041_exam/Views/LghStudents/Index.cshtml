@model IEnumerable<LeGiaHung2410900041_exam.Models.LghStudent>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 mb-1">Danh sách sinh viên</h1>
        <p class="text-muted mb-0">Quản lý thông tin sinh viên</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm sinh viên</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-primary">
        <tr>
            <th>Họ và tên</th>
            <th>Giới tính</th>
            <th>Ngày sinh</th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Trạng thái</th>
            <th class="text-end">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="fw-semibold">@item.LghName</td>
            <td>@(item.LghGender == true ? "Nam" : item.LghGender == false ? "Nữ" : "Chưa cập nhật")</td>
            <td>@item.LghBirthDay?.ToString("dd/MM/yyyy")</td>
            <td>@item.LghEmail</td>
            <td>@item.LghPhone</td>
            <td>
                @if (item.LghActive == true)
                {
                    <span class="badge rounded-pill text-bg-success">Đang hoạt động</span>
                }
                else
                {
                    <span class="badge rounded-pill text-bg-secondary">Ngừng hoạt động</span>
                }
            </td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
            </td>
        </tr>
}
    </tbody>
        </table>
    </div>
</div>
