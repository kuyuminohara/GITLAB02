@model List<LGH_LAB03.Models.LghProduct>;
@{
    ViewData["Title"] = "Danh sach san pham";
    int stt = 0;
}

<h1>LghGetAllProduct</h1>
<div class="card">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (LghProduct item in Model)
                {
                    stt++;
                    <tr>
                        <td>@stt</td>
                        <td>@item.LghProductId</td>
                        <td>@item.LghProductName</td>
                        <td>@item.LghYearRelease</td>
                        <td>@item.LghProductNumber.ToString("N0") đ</td>
                        <td>
                            <a href="3">xem</a>
                            <a href="3">sua</a>
                            <a href="3">xoa</a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="6">Tong so san pham: @Model.Count</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>



