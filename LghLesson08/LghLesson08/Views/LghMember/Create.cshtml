@model LghLesson08.Models.LghMember

@{
    ViewData["Title"] = "Tạo mới thành viên";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-plus-fill"></i>
                @ViewData["Title"]
            </h3>
        </div>
        <div class="card-body">

            <form asp-action="LghCreate" method="post">

                <div asp-validation-summary="All"
                     class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="LghMemberId"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="LghMemberId"
                               class="form-control"
                               placeholder="Nhập mã thành viên" />

                        <span asp-validation-for="LghMemberId"
                              class="text-danger">
                        </span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LghUserName"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="LghUserName"
                               class="form-control"
                               placeholder="Nhập tên tài khoản" />

                        <span asp-validation-for="LghUserName"
                              class="text-danger">
                        </span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LghPassword"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="LghPassword"
                               type="password"
                               class="form-control"
                               placeholder="Nhập mật khẩu" />

                        <span asp-validation-for="LghPassword"
                              class="text-danger">
                        </span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LghFullName"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="LghFullName"
                               class="form-control"
                               placeholder="Nhập họ và tên" />

                        <span asp-validation-for="LghFullName"
                              class="text-danger">
                        </span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LghEmail"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="LghEmail"
                               type="email"
                               class="form-control"
                               placeholder="example@gmail.com" />

                        <span asp-validation-for="LghEmail"
                              class="text-danger">
                        </span>
                    </div>

                </div>
                <div class="border-top pt-3 mt-2">

                    <button type="submit"
                            class="btn btn-primary me-2">
                        <i class="bi bi-save"></i>
                        Lưu thành viên
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
