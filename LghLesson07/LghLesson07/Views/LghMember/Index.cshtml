@model IEnumerable<LghLesson07.Models.DataModels.LghMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LghMemberId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghUserId)
            </th>
                @Html.DisplayNameFor(model => model.LghPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghEmail)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.LghMemberId)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghUserId)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghFullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghEmail)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.LghMemberId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.LghMemberId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.LghMemberId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
