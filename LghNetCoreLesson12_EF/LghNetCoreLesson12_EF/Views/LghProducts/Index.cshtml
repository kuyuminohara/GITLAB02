@model IEnumerable<LghNetCoreLesson12_EF.Models.LghProduct>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LghName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghSalePrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghCategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghCreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LghCategory)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.LghName)
            </td>
            <td>
                @if (item.LghImage?.Length > 0)
                {
                    <img src="@Url.Action("LghImage", "LghProducts", new { id = item.Id })" alt="@item.LghName" class="product-list-image" />
                }
                else
                {
                    <span class="text-muted">No image</span>
                }
            </td>
            <td>
                @Html.DisplayFor(model => item.LghPrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghSalePrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghDescription)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghCategoryId)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghCreatedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.LghCategory)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
