@model IEnumerable<LghNetCoreLesson12_EF.Models.LghCategory>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <p class="text-primary text-uppercase fw-semibold small mb-1">Management</p>
        <h1 class="display-6 fw-bold mb-1">Categories</h1>
        <p class="text-muted mb-0">Manage product categories in your catalog.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4">
        <span class="me-1">+</span> New category
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-0 p-4">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold">All categories</h5>
            <span class="badge rounded-pill text-bg-light">@Model.Count() total</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Status</th>
                    <th>Created date</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <div class="text-muted mb-2">No categories found.</div>
                            <a asp-action="Create" class="btn btn-sm btn-outline-primary">Create the first category</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                        @item.LghName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-semibold">@item.LghName</span>
                                </div>
                            </td>
                            <td>
                                @if (item.LghStatus != 0)
                                {
                                    <span class="badge rounded-pill text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-muted">@item.LghCreatedDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
