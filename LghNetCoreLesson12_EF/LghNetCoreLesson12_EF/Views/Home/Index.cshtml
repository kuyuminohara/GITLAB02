@model IEnumerable<LghNetCoreLesson12_EF.Models.LghProduct>

@{
    ViewData["Title"] = "Home";
}

<div id="lghHomeBanner" class="carousel slide lgh-home-banner shadow-sm rounded-4 overflow-hidden mb-5" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#lghHomeBanner" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#lghHomeBanner" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#lghHomeBanner" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="lgh-banner-slide lgh-banner-slide-one">
                <div class="container py-5">
                    <div class="row align-items-center min-vh-25">
                        <div class="col-lg-7 text-white">
                            <span class="badge rounded-pill bg-white text-primary mb-3">NEW COLLECTION</span>
                            <h1 class="display-4 fw-bold">Discover products made for you</h1>
                            <p class="lead mb-4">Explore our latest products and find something you will love.</p>
                            <a asp-controller="LghProducts" asp-action="Index" class="btn btn-light btn-lg px-4">Shop now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="lgh-banner-slide lgh-banner-slide-two">
                <div class="container py-5">
                    <div class="row align-items-center min-vh-25">
                        <div class="col-lg-7 text-white">
                            <span class="badge rounded-pill bg-warning text-dark mb-3">SPECIAL OFFER</span>
                            <h2 class="display-5 fw-bold">Quality products, better prices</h2>
                            <p class="lead mb-4">Find the right product for your everyday needs.</p>
                            <a asp-controller="LghCategories" asp-action="Index" class="btn btn-warning btn-lg px-4">Browse categories</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="lgh-banner-slide lgh-banner-slide-three">
                <div class="container py-5">
                    <div class="row align-items-center min-vh-25">
                        <div class="col-lg-7 text-white">
                            <span class="badge rounded-pill bg-info text-dark mb-3">WELCOME</span>
                            <h2 class="display-5 fw-bold">A simple and modern catalog</h2>
                            <p class="lead mb-4">Manage your products and categories with ease.</p>
                            <a asp-controller="LghProducts" asp-action="Create" class="btn btn-info btn-lg px-4">Add a product</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#lghHomeBanner" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#lghHomeBanner" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <p class="text-primary text-uppercase fw-semibold small mb-1">Our catalog</p>
        <h2 class="fw-bold mb-1">Featured products</h2>
        <p class="text-muted mb-0">Browse the latest products in our store.</p>
    </div>
    <a asp-controller="LghProducts" asp-action="Index" class="btn btn-outline-primary">View all products</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-5">
        <h5 class="fw-semibold">No products available</h5>
        <p class="text-muted mb-3">Start by adding your first product.</p>
        <a asp-controller="LghProducts" asp-action="Create" class="btn btn-primary">Add product</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm product-card rounded-4 overflow-hidden">
                    <div class="product-image-wrapper">
                        @if (item.LghImage?.Length > 0)
                        {
                            <img src="@Url.Action("LghImage", "LghProducts", new { id = item.Id })" class="card-img-top product-image" alt="@item.LghName" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                        }
                        <div class="product-placeholder @(item.LghImage?.Length > 0 ? "d-none" : "")">
                            <span class="display-5">◈</span>
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h5 class="card-title fw-semibold mb-0">@item.LghName</h5>
                            @if (item.LghStatus != 0)
                            {
                                <span class="badge text-bg-success rounded-pill">Active</span>
                            }
                        </div>
                        <p class="card-text text-muted small flex-grow-1">@item.LghDescription</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fs-5 fw-bold text-primary">@item.LghPrice.ToString("N0")</span>
                            <a asp-controller="LghProducts" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
